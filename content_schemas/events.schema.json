{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "touhou-events",
  "type": "object",
  "required": ["personal_events", "ambient_events"],
  "properties": {
    "personal_events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "ambient_events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "title", "scenes", "description", "hooks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "npc": {"type": "string", "minLength": 1},
        "scenes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "hooks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
