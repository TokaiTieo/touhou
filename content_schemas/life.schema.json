{
  "$id": "touhou-life",
  "type": "object",
  "required": ["version", "npc_traits", "plans", "activities", "festivals"],
  "properties": {
    "version": {"type": "integer"},
    "npc_traits": {"type": "object", "additionalProperties": {"type": "object", "required": ["style", "likes", "dislikes"], "properties": {
      "style": {"type": "string", "enum": ["主动", "直率", "含蓄"]}, "likes": {"type": "array", "items": {"type": "string"}},
      "dislikes": {"type": "array", "items": {"type": "string"}}, "need": {"type": "string"}
    }}},
    "plans": {"type": "object", "additionalProperties": {"type": "object", "required": ["title", "scene", "hours", "resource", "amount"], "properties": {
      "title": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1}, "hours": {"type": "number", "minimum": 0.01, "maximum": 12},
      "resource": {"type": "string", "minLength": 1}, "amount": {"type": "integer", "minimum": 1, "maximum": 99}
    }}},
    "activities": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "scene", "hours", "fatigue", "currency", "skill", "output"], "properties": {
      "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1},
      "hours": {"type": "number", "minimum": 0.01, "maximum": 12}, "fatigue": {"type": "number", "minimum": 0, "maximum": 100},
      "currency": {"type": "number", "minimum": 0, "maximum": 1000}, "skill": {"type": "string", "enum": ["交涉熟练度", "调查熟练度", "生存熟练度"]},
      "output": {"type": "string", "minLength": 1}, "input": {"type": "string", "minLength": 1},
      "input_quantity": {"type": "integer", "minimum": 1, "maximum": 99}, "npc": {"type": "string"}
    }}},
    "festivals": {"type": "array", "items": {"type": "object", "required": ["id", "title", "scene", "day", "period"], "properties": {
      "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1},
      "day": {"type": "integer", "minimum": 1}, "period": {"type": "integer", "minimum": 1}
    }}}
  }
}
